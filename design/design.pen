        {
          "type": "text",
          "id": "G66GH",
          "name": "Scope",
          "fill": "#26312C",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "同じfixtureで比較。Homeタイトル「愛用品」、ゴシック、全itemのprogress % + 3pt bar、1:1/aspectFit、同じUsage NotesとDetail/History。採用は人間の選択。",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
